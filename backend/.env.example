NODE_ENV=development
HOST=0.0.0.0
PORT=8787
API_PREFIX=/api/v1
LOG_LEVEL=info
APP_ALLOWED_ORIGINS=http://localhost:5173
# Production:
# APP_ALLOWED_ORIGINS=https://tjyoga.ru

# Auth scaffold (self-host Supabase friendly)
# В production всегда false; локально можно true для разработки без JWT
AUTH_DEV_BYPASS_ENABLED=false
DEV_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002
DEV_DEFAULT_USER_ROLE=student
SUPABASE_URL=https://supabase.example.local
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_JWT_SECRET=dev-only-supabase-jwt-secret
SUPABASE_JWT_ISSUER=tj-yoga-auth
SUPABASE_JWT_AUDIENCE=authenticated

# Database
# Leave empty for in-memory fallback (local/dev/tests without Postgres).
# Required in production. Example after `docker compose up -d` in backend/:
# DATABASE_URL=postgres://tjyoga:tjyoga@127.0.0.1:5432/tjyoga
DATABASE_URL=

# Node pg pool — keep tiny on the 1.5GiB Jino VPS (do not assume max_connections=100).
PG_POOL_MAX=4
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=5000

# Prodamus
PRODAMUS_WEBHOOK_SECRET=dev-prodamus-webhook-secret
PRODAMUS_SIGNATURE_HEADER=x-prodamus-signature
PRODAMUS_SIGNATURE_ALGO=sha256
PRODAMUS_MODE=test
# true = stub payment links (local/tests); false = live Prodamus link API
PRODAMUS_STUB_ENABLED=true
PRODAMUS_PAYFORM_URL=https://payform.ru/t5a23mO/
PRODAMUS_PAYFORM_SECRET=
PRODAMUS_SYS_CODE=
PRODAMUS_API_KEY_TEST=
PRODAMUS_API_KEY_LIVE=

# Kinescope
KINESCOPE_AUTH_SECRET=dev-kinescope-auth-secret

# Zoom
ZOOM_REDIRECT_ENCRYPTION_KEY=dev-zoom-encryption-key-32-chars
ZOOM_ROOM_MAIN_URL=https://zoom.us/j/123456789?pwd=replace-me

# Access policy
SUBSCRIPTION_GRACE_HOURS=72
